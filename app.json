{
  "expo": {
    "name": "Triathlon Tracker",
    "slug": "triathlon-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "platforms": ["android"],
    "android": {
      "package": "com.destiro.triathlontracker",
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundColor": "#0B3D91",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Triathlon Tracker uses your location while you record a run or ride, to measure distance, pace and your route.",
          "isAndroidBackgroundLocationEnabled": false
        }
      ]
    ]
  }
}
